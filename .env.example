# MongoDB Atlas connection string (create a free cluster at mongodb.com/atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/adobe-stock-metadata?retryWrites=true&w=majority

# Random long secret used to sign login tokens (any long random string)
JWT_SECRET=replace-with-a-long-random-string

# 32-byte hex string (64 hex characters) used to encrypt each user's Gemini API key at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-a-64-character-hex-string

# Max images per /api/generate request (1-10, default 10). Keep BATCH_SIZE in
# client/src/pages/Dashboard.jsx in sync.
# GEMINI_BATCH_SIZE=10

# Optional: daily request limits used for the per-key usage bars in Settings.
# These are only estimates — the first time a key returns the provider's 429
# quota payload the server learns the real limit and stores it on the key. Set
# these if your project's free tier differs, or if you're on a paid tier.
# RPD_<MODEL>  and  RPD_<PROVIDER>  (both uppercased, non-alphanumerics -> _)
# RPD_GEMINI_2_5_FLASH=1000
# RPD_GEMINI_2_5_PRO=1000
# RPD_GEMINI=1000

# Google OAuth Client ID for "Continue with Google" sign-in (optional).
# Create one at https://console.cloud.google.com/apis/credentials (Web application).
# The client also needs the same value as VITE_GOOGLE_CLIENT_ID (client/.env).
GOOGLE_CLIENT_ID=your-apps-google-client-id.apps.googleusercontent.com
