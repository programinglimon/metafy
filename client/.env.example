# Base URL of the backend (Render). Leave empty in local dev so the Vite proxy
# (vite.config.js) forwards /api/* to Express on http://localhost:5000.
# Set this in Vercel Project Settings -> Environment Variables (it's baked into
# the build), e.g. VITE_API_URL=https://your-api.onrender.com
VITE_API_URL=
# Google OAuth Client ID for "Continue with Google" (same value as the server GOOGLE_CLIENT_ID).
# Empty/omitted -> only email/password sign-in is shown. Baked into the Vite build.
VITE_GOOGLE_CLIENT_ID=
